# 🔑 Танзимоти лоиҳаи danatel.tj
# Ин файлро ба `.env` нусхабардорӣ кунед:  cp backend/.env.example backend/.env

# ====== DATABASE ======
DATABASE_URL=postgresql+psycopg2://danatel:danatel_secret@localhost:5432/danatel

# ====== SECURITY ======
# Барои ҳифзи JWT — бод 100+ ҳарфи тасодуфӣ
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====== DC WALLET ======
DC_MERCHANT_ID=your_merchant_id
DC_SECRET_KEY=your_dc_secret_key
DC_API_URL=https://api.dcpay.tj
DC_WEBHOOK_URL=https://your-domain.tj/api/webhook/dc

# ====== TELEGRAM BOT ======
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_ADMIN_CHAT_ID=123456789

# ====== APP ======
FRONTEND_URL=http://localhost:5173
# Вуруди админ: /admin
ADMIN_PHONE=992000000000
ADMIN_PASSWORD=change_me_admin

# 0 = бот фаъол, 1 = бот хомӯш
DISABLE_TELEGRAM=0
